---
import Page from "../layouts/Page.astro"

import "../styles/global.css";
---

<Page
title="Crist For Life: Devotions and Prayer" 
  description="Meet with us and discover a time of fellowship, prayer, and devotion. We meet the first Monday of the Month at 7:00 PM."
 image="https://cflmc.org/public/favicon.avif"
>
  <header
    class="py-16 text-center border-b border-chrome-400/10 bg-linear-to-b from-asphalt-900 to-asphalt-950"
  >
    <h1 class="mb-4 text-5xl font-headline text-gold-500">Prayer Requests</h1>
    <p class="max-w-xl mx-auto text-lg/8 text-slate-300">
      "Carry each other’s burdens, and in this way you will fulfill the law of
      Christ."
    </p>
    <cite class="not-italic">
      <span
        class="font-sans text-sm font-extrabold tracking-[0.3em] uppercase md:text-lg"
      >
        Galations 6:2
      </span>
    </cite>
  </header>

  <main class="max-w-4xl px-6 py-16 mx-auto">
    <div class="space-y-12">
  <section
      class="p-8 text-center border rounded-sm border-gold-500/20 bg-asphalt-900/50 shadow-sm"
    >
      <h3 class="mb-4 text-xl font-bold text-divine-white">Join us on Facebook Live
        
      </h3>
      <p class="mb-6 text-sm/6 text-slate-400">
       We meet virtually on facebook live the first Monday of the month! Come join us for a time of fellowship, worship, prayer, and Bible Study.
      </p>
      <a
            href="https://www.facebook.com/groups/3043779952326376">
      <button
        class="px-8 py-3 font-bold tracking-widest uppercase transition-colors rounded-xs bg-gold-500 text-asphalt-950 hover:bg-gold-50 hover:cursor-pointer text-sm"
      >
        Click for Link
        
      </button>
      
      </a>
    </section>

    <section
      class="mt-20 p-8 text-center border rounded-sm border-gold-500/20 bg-asphalt-900/50 shadow-sm"
    >
      <h3 class="mb-4 text-xl font-bold text-divine-white">Have a request?</h3>
      <p class="mb-6 text-sm/6 text-slate-400">
        If you have a prayer request you would like to share with the CFL
        community, please reach out to a member or visit the clubhouse.
      </p>
      <a
            href="mailto:contact@cflmm.com?subject=Prayer%Request%">
      <button
        class="px-8 py-3 font-bold tracking-widest uppercase transition-colors rounded-xs bg-gold-500 text-asphalt-950 hover:bg-gold-50 hover:cursor-pointer text-sm"
      >
        Submit Request
      </button>
      </a>
    </section>
  </main>
</Page>
