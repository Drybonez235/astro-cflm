---
import Page from "../layouts/Page.astro"

import "../styles/global.css";
---

<Page
title="Crist For Life: Devotions and Prayer" 
  description="Meet with us and discover a time of fellowship, prayer, and devotion. We meet the first Monday of the Month at 7:00 PM."
 image="https://cflmc.org/public/favicon.svg"
>
  <header
    class="py-16 text-center border-b border-chrome-400/10 bg-linear-to-b from-asphalt-900 to-asphalt-950"
  >
    <h1 class="mb-4 text-5xl font-headline text-gold-500">Monthly Service and Prayer</h1>
    <p class="max-w-xl mx-auto text-lg/8 text-slate-300">
      "Carry each other’s burdens, and in this way you will fulfill the law of
      Christ."
    </p>
    <cite class="not-italic">
      <span
        class="font-sans text-sm font-extrabold tracking-[0.3em] uppercase md:text-lg"
      >
        Galations 6:2
      </span>
    </cite>
  </header>

  <main class="max-w-4xl px-6 py-16 mx-auto">
    <div class="flex flex-col gap-8 max-w-4xl mx-auto">
  <!-- Highlighted Facebook Live Hero Card -->
  <section
    class="p-8 text-center border rounded-xs border-gold-500 bg-asphalt-900/80 shadow-md ring-1 ring-gold-500/50"
  >
   
    <h3 class="mb-4 text-2xl font-bold text-divine-white">
      Monthly Service
    </h3>
    <p class="max-w-xl mx-auto mb-8 text-sm/6 text-slate-300">
      Meet us at 7:00 PM at the clubhouse or virtually at 7:30 every first Monday of the month! Join us for a time of fellowship, worship, prayer, and Bible study.
    </p>
    <a
      href="https://www.facebook.com/groups/3043779952326376"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block"
    >
      <button
        class="px-8 py-3.5 text-sm font-bold tracking-widest uppercase transition-colors rounded-xs bg-gold-500 text-asphalt-950 hover:bg-gold-50 hover:cursor-pointer shadow-xs"
      >
        Facebook Live
      </button>
    </a>
  </section>

  <!-- Resources Section -->
  <section
    class="p-8 text-center border rounded-xs border-gold-500/20 bg-asphalt-900/50 shadow-xs"
  >
    <h3 class="mb-2 text-xl font-bold text-divine-white">CFL Prayer Requests and Resources</h3>
    <p class="mb-8 text-sm/6 text-slate-400">
      Submit prayer requests, visit our prayer page, or view our monthly service materials below.
    </p>

    <!-- 3-Button Resource Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- 1. Submit Prayer Request -->
      <a
        href="mailto:samurai@cflmm.com?subject=Prayer%20Request"
        class="flex"
      >
        <button
          class="w-full px-4 py-3.5 text-xs font-bold tracking-wider uppercase transition-colors rounded-xs border border-gold-500/40 bg-asphalt-950 text-gold-500 hover:bg-gold-500 hover:text-asphalt-950 hover:cursor-pointer"
        >
          Submit Prayer Request
        </button>
      </a>

      <!-- 2. Prayer Request Facebook Page -->
      <a
        href="https://www.facebook.com/groups/3043779952326376"
        target="_blank"
        rel="noopener noreferrer"
        class="flex"
      >
        <button
          class="w-full px-4 py-3.5 text-xs font-bold tracking-wider uppercase transition-colors rounded-xs border border-gold-500/40 bg-asphalt-950 text-gold-500 hover:bg-gold-500 hover:text-asphalt-950 hover:cursor-pointer"
        >
          View Prayer Page
        </button>
      </a>

      <!-- 3. Latest Service Handout -->
      <a
        href="/handout.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="flex"
      >
        <button
          class="w-full px-4 py-3.5 text-xs font-bold tracking-wider uppercase transition-colors rounded-xs border border-gold-500/40 bg-asphalt-950 text-gold-500 hover:bg-gold-500 hover:text-asphalt-950 hover:cursor-pointer"
        >
          Read Latest Handout
        </button>
      </a>
    </div>
  </section>
</div>
  </main>
</Page>
